<template>
  <div class="suggestions-wrapper">
    <div class="suggestions-header">
      <span class="suggestions-title">✦ Sugerencias automáticas</span>
      <span v-if="source === 'gemini'" class="source-badge gemini-badge">✦ Gemini AI</span>
      <span v-else-if="source === 'keywords'" class="source-badge keywords-badge">Keywords</span>
    </div>

    <!-- Cargando -->
    <div v-if="loading" class="sug-state">
      ⏳ {{ loadingMsg }}
    </div>

    <!-- Error -->
    <div v-else-if="error" class="sug-state sug-error">
      {{ error }}
      <button class="btn-retry" @click="fetchKeywords">Reintentar</button>
    </div>

    <!-- Sin resultados -->
    <div v-else-if="suggestions.length === 0" class="sug-state">
      Sin sugerencias disponibles
    </div>

    <!-- Resultados -->
    <div v-else>
      <div class="sug-list">
        <div
          v-for="r in suggestions"
          :key="r.id"
          class="sug-item"
          :class="{ 'sug-assigned': isAssigned(r.id) }"
        >
          <div class="sug-info">
            <div class="sug-name">{{ r.nombre }}</div>
            <div class="sug-org">{{ r.organizacion }}</div>
            <div v-if="r.explanation" class="sug-explanation">{{ r.explanation }}</div>
            <div class="sug-tags">
              <span v-for="tag in r.tags" :key="tag" class="tag-chip">{{ tag }}</span>
            </div>
          </div>
          <div class="sug-right">
            <div class="score-badge" :class="scoreTier(r.score)">{{ r.score }}%</div>
            <div v-if="isAssigned(r.id)" class="sug-assigned-label">Ya asignado</div>
            <button
              v-else
              class="btn-assign-sug"
              :disabled="assigning === r.id"
              @click="assign(r)"
            >
              {{ assigning === r.id ? '...' : 'Asignar' }}
            </button>
          </div>
        </div>
      </div>

      <!-- Botón Gemini al pie -->
      <div class="gemini-row">
        <span class="gemini-hint">¿Quieres un análisis más preciso?</span>
        <button class="btn-gemini" :disabled="loading" @click="fetchGemini">
          ✦ Analizar con Gemini AI
        </button>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, watch, onMounted } from 'vue'
import axios from 'axios'

const props = defineProps({
  manuscriptId:       { type: String, required: true },
  manuscriptTitle:    { type: String, default: '' },
  manuscriptAbstract: { type: String, default: '' },
  manuscriptTags:     { type: Array,  default: () => [] },
  assignedReviewers:  { type: Array,  default: () => [] }
})

const emit = defineEmits(['assign'])

const suggestions = ref([])
const loading     = ref(false)
const loadingMsg  = ref('')
const error       = ref('')
const assigning   = ref(null)
const source      = ref(null)

// Al abrir el modal → carga automática por keywords
onMounted(fetchKeywords)
watch(() => props.manuscriptId, fetchKeywords)

async function fetchKeywords() {
  loadingMsg.value = 'Buscando coincidencias...'
  source.value = 'keywords'
  await _fetch('/api/matching/suggestions')
}

async function fetchGemini() {
  loadingMsg.value = 'Analizando con Gemini AI...'
  source.value = 'gemini'
  await _fetch('/api/matching/suggestions-gemini')
}

async function _fetch(endpoint) {
  loading.value = true
  error.value   = ''
  try {
    const res = await axios.post(endpoint, {
      title:        props.manuscriptTitle,
      abstract:     props.manuscriptAbstract,
      tags:         props.manuscriptTags,
      manuscriptId: props.manuscriptId
    })
    suggestions.value = res.data
  } catch (err) {
    console.error('Error en sugerencias:', err)
    error.value  = err.response?.data?.error || 'No se pudieron cargar las sugerencias'
    source.value = null
  } finally {
    loading.value = false
  }
}

function isAssigned(reviewerId) {
  return props.assignedReviewers?.some(r => r.reviewerId === reviewerId)
}

function scoreTier(score) {
  if (score >= 60) return 'score-high'
  if (score >= 30) return 'score-mid'
  return 'score-low'
}

async function assign(reviewer) {
  assigning.value = reviewer.id
  emit('assign', reviewer.id)
  setTimeout(() => { assigning.value = null }, 1500)
}
</script>

<style scoped>
.suggestions-wrapper {
  border: 1.5px solid #e0e7ff;
  border-radius: 12px;
  background: #f8f9ff;
  padding: 14px;
  margin-bottom: 16px;
}
.suggestions-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
}
.suggestions-title {
  font-size: 13px;
  font-weight: 600;
  color: #4f46e5;
  flex: 1;
}
.source-badge {
  font-size: 10px;
  font-weight: 600;
  padding: 2px 8px;
  border-radius: 100px;
}
.gemini-badge   { background: #ede9fe; color: #7c3aed; }
.keywords-badge { background: #e0f2fe; color: #0369a1; }

.sug-state { font-size: 13px; color: #6b7280; text-align: center; padding: 10px 0; }
.sug-error { color: #dc2626; display: flex; flex-direction: column; align-items: center; gap: 8px; }
.btn-retry {
  font-size: 11px;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 7px;
  border: none;
  background: #4f46e5;
  color: white;
  cursor: pointer;
}

.sug-list { display: flex; flex-direction: column; gap: 8px; }
.sug-item {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  background: white;
  border: 1.5px solid #e5e7eb;
  border-radius: 10px;
  padding: 10px 12px;
}
.sug-item.sug-assigned {
  opacity: 0.65;
  border-color: #22c55e;
  background: #f0fdf4;
}
.sug-info     { flex: 1; min-width: 0; }
.sug-name     { font-size: 13px; font-weight: 500; }
.sug-org      { font-size: 11px; color: #6b7280; margin-bottom: 4px; }
.sug-explanation {
  font-size: 11px;
  color: #4b5563;
  font-style: italic;
  margin-bottom: 5px;
  line-height: 1.4;
}
.sug-tags  { display: flex; flex-wrap: wrap; gap: 3px; }
.tag-chip  { font-size: 10px; padding: 2px 7px; background: #f3f4f6; border-radius: 100px; color: #6b7280; }
.sug-right { display: flex; flex-direction: column; align-items: center; gap: 6px; flex-shrink: 0; }
.score-badge  { font-size: 12px; font-weight: 700; padding: 3px 8px; border-radius: 100px; white-space: nowrap; }
.score-high   { background: #dcfce7; color: #16a34a; }
.score-mid    { background: #fef9c3; color: #ca8a04; }
.score-low    { background: #fee2e2; color: #dc2626; }
.sug-assigned-label { font-size: 10px; color: #22c55e; font-weight: 600; }
.btn-assign-sug {
  font-size: 11px;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 8px;
  border: none;
  background: #4f46e5;
  color: white;
  cursor: pointer;
  white-space: nowrap;
}
.btn-assign-sug:hover:not(:disabled) { background: #4338ca; }
.btn-assign-sug:disabled { opacity: 0.6; cursor: not-allowed; }

.gemini-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #e0e7ff;
}
.gemini-hint { font-size: 11px; color: #9ca3af; }
.btn-gemini {
  font-size: 11px;
  font-weight: 700;
  padding: 6px 14px;
  border-radius: 8px;
  border: none;
  background: linear-gradient(135deg, #7c3aed, #4f46e5);
  color: white;
  cursor: pointer;
  box-shadow: 0 2px 6px rgba(124,58,237,0.2);
  transition: opacity .15s;
  white-space: nowrap;
}
.btn-gemini:hover:not(:disabled) { opacity: .88; }
.btn-gemini:disabled { opacity: 0.5; cursor: not-allowed; }
</style>
